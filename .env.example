# =========================================================================
# Dealer Social Post AI — environment variables
# Copy to .env.local for development. Server variables become Fly secrets;
# VITE_ variables are public build-time configuration, never secrets.
# =========================================================================

# ---- AI providers (server-side only, never VITE_-prefixed) --------------
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ENABLE_CLAUDE_FALLBACK=false
ENABLE_OPENAI_FALLBACK=false

# ---- Session + auth -----------------------------------------------------
# 6-12 character alphanumeric dealer code that grants super-admin powers.
# REQUIRED in production — there is no hardcoded fallback. Create a dealer
# whose `code` matches this value (or let login auto-provision it once).
ADMIN_DEALER_CODE=

# Optional fallback for server-to-server callers (cron, monitoring) that
# can't hold a session cookie. The browser never sends this — leave unset
# if you don't have S2S callers.
PROXY_ACCESS_TOKEN=

# Optional comma-separated exact hosts or `*.trusted-domain.example` suffixes
# that the authenticated image proxy may fetch. Built-in defaults cover the
# production Fly host and direct Imgur images. Because PocketBase 0.22 cannot
# pin DNS or inspect redirect targets, add only origins
# whose DNS and redirect behavior you trust; never add user-controlled hosts.
IMAGE_PROXY_ALLOWED_HOSTS=

# ---- PocketBase app runtime ---------------------------------------------
VITE_POCKETBASE_URL=http://127.0.0.1:8090

# ---- Explicit maintenance-script credentials ---------------------------
# Keep real values in your shell or secret manager. Mutating scripts also
# require PB_MUTATION_TARGET to exactly match PB_URL and the documented
# confirmation phrase; never commit either credential.
PB_URL=
PB_ADMIN_EMAIL=
PB_ADMIN_PASSWORD=
PB_MUTATION_TARGET=
PB_MUTATION_CONFIRMATION=

# Production-to-local sync uses separate credentials for each environment.
PB_PROD_URL=
PB_PROD_ADMIN_EMAIL=
PB_PROD_ADMIN_PASSWORD=
PB_LOCAL_URL=
PB_LOCAL_ADMIN_EMAIL=
PB_LOCAL_ADMIN_PASSWORD=
PB_SYNC_SOURCE=
PB_SYNC_TARGET=
PB_SYNC_CONFIRMATION=

# Generic guarded upload smoke test.
PB_UPLOAD_DEALER_ID=
PB_UPLOAD_IMAGE_PATH=

# ---- Deployment ---------------------------------------------------------
PORT=5173

# ---- Public frontend build flags ---------------------------------------
# In Docker/Fly builds, pass these with --build-arg. Matching server-side
# ENABLE_* and provider-key values are also required.
VITE_ENABLE_CLAUDE_FALLBACK=false
VITE_ENABLE_OPENAI_FALLBACK=false
