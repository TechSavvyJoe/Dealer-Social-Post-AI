# =========================================================================
# Dealer Social Post AI — environment variables
# Copy to .env.local for development. Server variables become Fly secrets;
# VITE_ variables are public build-time configuration, never secrets.
# =========================================================================

# ---- AI providers (server-side only, never VITE_-prefixed) --------------
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ENABLE_CLAUDE_FALLBACK=false
ENABLE_OPENAI_FALLBACK=false

# ---- Session + auth -----------------------------------------------------
# System-administrator sign-in credentials. REQUIRED in production. On boot
# the server provisions/rotates a locked PocketBase auth account from these
# values; the database stores only the one-way password verifier. Username:
# 3-32 chars starting with a letter. Password: 8-128 exact characters.
# Changing the password invalidates outstanding administrator sessions.
ADMIN_LOGIN_USERNAME=
ADMIN_LOGIN_PASSWORD=

# Server-side pepper for salesperson access-code hashing (32+ random chars,
# e.g. `openssl rand -hex 24`). PIN login and person creation fail closed
# without it, and a copied database cannot be brute-forced across the 10^4
# code space. Rotating it invalidates every stored code — never rotate
# casually; rotate-pin each person instead.
SALESPERSON_PIN_PEPPER=

# Managed Cloudflare Turnstile. The secret is server-only; the site key is
# public and must match VITE_TURNSTILE_SITE_KEY in the promoted frontend.
TURNSTILE_SECRET=
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_ALLOWED_HOSTNAMES=localhost,127.0.0.1
TURNSTILE_ENFORCEMENT_ENABLED=false

# A random 32+ character value installed identically in Fly and Vercel. Vercel
# injects it into the same-origin /api proxy request; browsers never receive it.
VERCEL_TO_FLY_PROXY_SECRET=

# ---- Joe Gallant Customer Hub private-draft delivery -------------------
# All four values are server-only. The dealer guard is mandatory and keeps
# this single-site destination unavailable to every other dealership tenant.
CUSTOMER_HUB_URL=
CUSTOMER_HUB_SECRET=
CUSTOMER_HUB_DESTINATION_ID=
CUSTOMER_HUB_DEALER_ID=

# One-release bridge for the previously deployed frontend. It never exposes a
# real PIN. Set true for the backend-first compatibility release, then false
# immediately after the matching Vercel artifact is promoted and verified.
LEGACY_CLIENT_COMPATIBILITY_ENABLED=true

# Optional comma-separated exact hosts or `*.trusted-domain.example` suffixes
# that the authenticated image proxy may fetch. Built-in defaults cover the
# production Fly host and direct Imgur images. Because PocketBase 0.22 cannot
# pin DNS or inspect redirect targets, add only origins
# whose DNS and redirect behavior you trust; never add user-controlled hosts.
IMAGE_PROXY_ALLOWED_HOSTS=

# ---- PocketBase app runtime ---------------------------------------------
VITE_POCKETBASE_URL=http://127.0.0.1:8090
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Public rollout flag. Keep false until the private upload broker, worker, and
# dealership YouTube connection are configured and verified end to end.
VITE_WALKAROUND_STUDIO_ENABLED=false

# Server-side walkaround gate and private infrastructure. Keep the server gate
# false until every referenced service is provisioned and the real release
# proof has passed. Tokens and signing secrets must be at least 32 characters.
WALKAROUND_STUDIO_ENABLED=false
WALKAROUND_GCS_BUCKET=
WALKAROUND_UPLOAD_BROKER_URL=
WALKAROUND_UPLOAD_BROKER_TOKEN=
WALKAROUND_YOUTUBE_BROKER_URL=
WALKAROUND_YOUTUBE_BROKER_TOKEN=
WALKAROUND_WORKER_TOKEN=
WALKAROUND_WORKER_SIGNING_SECRET=
# One-release bridge: keep unset (v1 signatures allowed) until every worker
# sends v2 signatures (method+path+idempotency+nonce bound), then set false
# and delete the v1 branch in pb_hooks/walkarounds.js internalAuth.
# WALKAROUND_SIGNATURE_V1_ALLOWED=false

# ---- Private off-box backup workflow (server/CI only) -------------------
# Production uses the exact Fly origin for both URL variables. The workflow
# resolves the two release SHAs and refuses source or manifest drift.
POCKETBASE_BACKUP_URL=
POCKETBASE_EXPECTED_ORIGIN=
POCKETBASE_EXPECTED_RELEASE_SHA=
POCKETBASE_TARGET_RELEASE_SHA=
POCKETBASE_SOURCE_IDENTITY=
POCKETBASE_SOURCE_IMAGE_DIGEST=
POCKETBASE_BOOTSTRAP_IDENTITY_VERIFIED=false
POCKETBASE_ADMIN_EMAIL=
POCKETBASE_ADMIN_PASSWORD=
POCKETBASE_R2_BACKUPS_ENABLED=false
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BACKUP_PREFIX=dealer-social-post-ai/pocketbase

# First v2 release only: the v1 health response has no releaseSha. The backup
# workflow may instead attest the authenticated Fly image's GH_SHA + digest for
# a maximum 24-hour window. Remove/false both values as soon as v2 is healthy.
ALLOW_FLY_IMAGE_IDENTITY_BOOTSTRAP=false
FLY_IMAGE_IDENTITY_BOOTSTRAP_EXPIRES_AT=

# ---- Explicit maintenance-script credentials ---------------------------
# Keep real values in your shell or secret manager. Mutating scripts also
# require PB_MUTATION_TARGET to exactly match PB_URL and the documented
# confirmation phrase; never commit either credential.
PB_URL=
PB_ADMIN_EMAIL=
PB_ADMIN_PASSWORD=
PB_MUTATION_TARGET=
PB_MUTATION_CONFIRMATION=

# Production-to-local sync uses separate credentials for each environment.
PB_PROD_URL=
PB_PROD_ADMIN_EMAIL=
PB_PROD_ADMIN_PASSWORD=
PB_LOCAL_URL=
PB_LOCAL_ADMIN_EMAIL=
PB_LOCAL_ADMIN_PASSWORD=
PB_SYNC_SOURCE=
PB_SYNC_TARGET=
PB_SYNC_CONFIRMATION=

# Generic guarded upload smoke test.
PB_UPLOAD_DEALER_ID=
PB_UPLOAD_IMAGE_PATH=

# ---- Playwright real-PocketBase e2e (optional, local/CI canary) ---------
# When set, e2e/real-pocketbase.spec.ts exercises a live backend instead of
# stubs. Point E2E_BASE_URL at the served app (Vite :5173 or container :8090).
# E2E_REAL_POCKETBASE=true
# E2E_BASE_URL=http://127.0.0.1:5173
# E2E_ADMIN_USERNAME=
# E2E_ADMIN_PASSWORD=

# ---- Deployment ---------------------------------------------------------
PORT=5173

# ---- Public frontend build flags ---------------------------------------
# In Docker/Fly builds, pass these with --build-arg. Matching server-side
# ENABLE_* and provider-key values are also required.
VITE_ENABLE_CLAUDE_FALLBACK=false
VITE_ENABLE_OPENAI_FALLBACK=false
# Required for production builds. The coordinated release scripts set this to
# the exact 40-character commit deployed to Fly and staged on Vercel.
VITE_RELEASE_SHA=
