# =========================================================================
# Dealer Social Post AI — environment variables
# Copy to .env.local for development; set as Fly secrets for production.
# =========================================================================

# ---- AI providers (server-side only, never VITE_-prefixed) --------------
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Vertex AI service account — paste the FULL JSON contents as a single line.
# Required for Veo (video) and Imagen 4 (image). Gemini API key alone covers
# the text + standard image paths.
VERTEX_SERVICE_ACCOUNT_JSON=

# ---- Session + auth -----------------------------------------------------
# 6-digit (or longer alphanumeric) dealer code that grants super-admin powers.
# REQUIRED in production — there is no hardcoded fallback. Create a dealer
# whose `code` matches this value (or let login auto-provision it once).
ADMIN_DEALER_CODE=

# Optional fallback for server-to-server callers (cron, monitoring) that
# can't hold a session cookie. The browser never sends this — leave unset
# if you don't have S2S callers.
PROXY_ACCESS_TOKEN=

# ---- PocketBase ---------------------------------------------------------
VITE_POCKETBASE_URL=http://127.0.0.1:8090
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# ---- Deployment ---------------------------------------------------------
PORT=5173

# ---- Feature flags ------------------------------------------------------
VITE_ENABLE_CLAUDE_FALLBACK=false
VITE_ENABLE_OPENAI_FALLBACK=false
