# Copy these keys into Output.ai's encrypted credential store. Never commit values.
walkaround:
  backend_base_url: credential:WALKAROUND_BACKEND_BASE_URL
  worker_bearer_token: credential:WALKAROUND_WORKER_BEARER_TOKEN
  worker_signing_secret: credential:WALKAROUND_WORKER_SIGNING_SECRET
  media_worker_base_url: credential:WALKAROUND_MEDIA_WORKER_BASE_URL
  media_worker_token: credential:WALKAROUND_MEDIA_WORKER_TOKEN
  temporal_api_key: credential:TEMPORAL_API_KEY
shotstack:
  api_key: credential:SHOTSTACK_API_KEY
  base_url: credential:SHOTSTACK_BASE_URL
auphonic:
  api_key: credential:AUPHONIC_API_KEY
  base_url: credential:AUPHONIC_BASE_URL
